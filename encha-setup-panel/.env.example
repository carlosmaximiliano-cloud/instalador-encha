# Endpoint do Portainer (DNS interno do Swarm em prod, http://localhost em dev)
PORTAINER_URL=http://portainer:9000

# Onde o master key fica em dev (em prod vem de /run/secrets/master_key)
MASTER_KEY_PATH=./data/master.key

# Caminho do SQLite (audit log + secrets cifrados)
DB_PATH=./data/panel.db

# Aceitar certificados self-signed no Portainer (apenas para dev local)
# PORTAINER_TLS_INSECURE=1
